{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "data-finder-ts": ["./src/index"],
      "data-finder-ts/datafinder/*": ["./src/datafinder/*"],
      "data-finder-ts/model/*": ["./src/model/*"],
      "@datafinder": ["./src/datafinder/index"],
      "@datafinder/*": ["./src/datafinder/*"],
      "@model/*": ["./src/model/*"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "example/generated/**/*", "tests/generated_dual_assoc/**/*"]
}
