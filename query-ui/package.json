{
  "name": "data-finder-query-ui",
  "version": "0.1.5",
  "description": "A query page for data-finder mappings: pick properties, filters and group by, build the SQL, run it on Databricks and analyse the rows in DuckDB. A CLI that builds and serves it, and React components to embed it.",
  "keywords": [
    "data-finder",
    "query",
    "sql",
    "databricks",
    "duckdb",
    "ag-grid",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackie-h/data-finder-ts.git",
    "directory": "query-ui"
  },
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "data-finder-query-ui": "./bin/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/styles.css",
    "./server": "./server/proxy.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/lib",
    "dist/types",
    "bin",
    "server",
    "!server/demo.mjs",
    "src",
    "!src/mappings",
    "index.html",
    "public",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "cd .. && uv run python query-ui/generate_mappings.py",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "typecheck": "tsc --noEmit",
    "proxy": "node server/proxy.mjs"
  },
  "dependencies": {
    "vite": "^8.3.8",
    "@vitejs/plugin-react": "^6.3.0"
  },
  "peerDependencies": {
    "@duckdb/duckdb-wasm": "^1.32.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "data-finder-ts": ">=0.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
