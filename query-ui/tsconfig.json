{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@datafinder": ["../src/datafinder/index"],
      "@datafinder/*": ["../src/datafinder/*"],
      "@model/*": ["../src/model/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
